{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://139.59.43.165:5000/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://139.59.43.165:5000/socket.io/:path*"
    },
    {
      "source": "/property/:id",
      "destination": "/api/property-meta?id=:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|facebookexternalhit|whatsapp|twitter|telegram|linkedinbot|pinterest|slack).*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://uniroomsin-production.up.railway.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    }
  ]
}